# Nexus bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Private control server (where the Nexus panel lives)
CONTROL_GUILD_ID=

# Optional. Target server Nexus administers.
# If omitted, Nexus uses the second server it is added to (the non-control guild).
TARGET_GUILD_ID=

# Channel in the control server for the persistent panel
CONTROL_CHANNEL_ID=

# Channel in the control server for reports, progress, and audit logs
LOG_CHANNEL_ID=

# Authorized operator Discord user ID (comma-separated for multiple owners)
OWNER_USER_ID=

# Optional. Local default is ./data. On Railway mount a volume at /data and set:
# DATA_DIR=/data
DATA_DIR=
